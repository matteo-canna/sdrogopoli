{
  "name": "sdrogopoli",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:itch": "tsc --noEmit && vite build --base ./ --outDir dist-itch && vite-node scripts/zip.ts dist-itch sdrogopoli-itch.zip",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:watch": "vitest",
    "simula": "vite-node scripts/simula.ts",
    "livelli": "vite-node scripts/livelli.ts",
    "preset": "vite-node scripts/preset.ts",
    "squadre": "vite-node scripts/squadre.ts",
    "quote": "vite-node scripts/quote.ts",
    "simula:valle": "vite-node scripts/simula.ts -- 300 4 docs/bilanciamento-valle.md valle"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "gltfpack": "^0.22.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "^0.170.0",
    "trystero": "^0.27.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
